{
  "name": "@nicbet/pi-mcp-extension",
  "version": "0.1.0",
  "description": "Expose stdio MCP servers configured in .mcp.json as Pi tools",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "biome lint index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.2.0",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
